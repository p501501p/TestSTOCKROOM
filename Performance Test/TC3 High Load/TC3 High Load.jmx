try { payload = new groovy.json.JsonSlurper().parseText(SampleResult.getResponseDataAsString()) } catch (Exception e) { AssertionResult.setFailure(true); AssertionResult.setFailureMessage(&apos;Invalid JSON: &apos; + e.message); return }
def ok = payload instanceof Map

          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="POST Test 2 - JSON product object" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">def payload
try { payload = new groovy.json.JsonSlurper().parseText(SampleResult.getResponseDataAsString()) } catch (Exception e) { AssertionResult.setFailure(true); AssertionResult.setFailureMessage(&apos;Invalid JSON: &apos; + e.message); return }
def ok = payload instanceof Map &amp;&amp; payload.product instanceof Map
AssertionResult.setFailure(!ok)
if (!ok) AssertionResult.setFailureMessage(&apos;Expected a JSON object containing product&apos;)</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
            <boolProp name="resetInterpreter">false</boolProp>
          </JSR223Assertion>
          <hashTree/>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="POST Test 3 - Product identity fields" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">def payload
try { payload = new groovy.json.JsonSlurper().parseText(SampleResult.getResponseDataAsString()) } catch (Exception e) { AssertionResult.setFailure(true); AssertionResult.setFailureMessage(&apos;Invalid JSON: &apos; + e.message); return }
def p = payload instanceof Map ? payload.product : null
def ok = p instanceof Map &amp;&amp; p.code == vars.get(&apos;PRODUCT_CODE&apos;) &amp;&amp; p.name == vars.get(&apos;PRODUCT_NAME&apos;) &amp;&amp; p.category == &apos;JMeter Test&apos;
AssertionResult.setFailure(!ok)
if (!ok) AssertionResult.setFailureMessage(&apos;Created product code, name, or category did not match the request&apos;)</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
            <boolProp name="resetInterpreter">false</boolProp>
          </JSR223Assertion>
          <hashTree/>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="POST Test 4 - Product numeric fields" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">def payload
try { payload = new groovy.json.JsonSlurper().parseText(SampleResult.getResponseDataAsString()) } catch (Exception e) { AssertionResult.setFailure(true); AssertionResult.setFailureMessage(&apos;Invalid JSON: &apos; + e.message); return }
def p = payload instanceof Map ? payload.product : null
def ok = p instanceof Map &amp;&amp; p.price instanceof Number &amp;&amp; p.price.intValue() == 1000 &amp;&amp; p.quantity instanceof Number &amp;&amp; p.quantity.intValue() == 10
AssertionResult.setFailure(!ok)
if (!ok) AssertionResult.setFailureMessage(&apos;Expected product price 1000 and quantity 10&apos;)</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
            <boolProp name="resetInterpreter">false</boolProp>
          </JSR223Assertion>

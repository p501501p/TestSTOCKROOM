          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Assert JSON products array" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper

def body = SampleResult.getResponseDataAsString()

try {
    def payload = new JsonSlurper().parseText(body)
    if (!(payload instanceof Map) || !(payload.products instanceof List)) {
        AssertionResult.setFailure(true)
        AssertionResult.setFailureMessage(&apos;Expected a JSON object with a products array&apos;)
    } else if (payload.products.any { product -&gt;
        !(product instanceof Map) || !product.keySet().containsAll([&apos;code&apos;, &apos;name&apos;, &apos;category&apos;, &apos;price&apos;, &apos;quantity&apos;])
    }) {
        AssertionResult.setFailure(true)
        AssertionResult.setFailureMessage(&apos;Each product must include code, name, category, price, and quantity&apos;)
    }
} catch (Exception e) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&apos;Invalid JSON response: &apos; + e.message)
}</stringProp>
